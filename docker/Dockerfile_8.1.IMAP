FROM php:8.1-fpm

# 1. Встановлюємо пакети для збірки PHP та IMAP з source
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    wget \
    bash \
    libssl-dev \
    libssl-doc \
    libkrb5-dev \
    libpam0g-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libonig-dev \
    libxml2-dev \
    libcurl4-openssl-dev \
    libzip-dev \
    unzip \
    iproute2 \
    netcat-openbsd \
    iputils-ping \
    telnet \
    pkg-config \
    autoconf \
    zlib1g-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 2. Скачуємо та збираємо UW-IMAP c-client
RUN wget https://ftp.icm.edu.pl/packages/imap/imap-2007f.tar.gz \
    && tar xzf imap-2007f.tar.gz \
    && cd imap-2007f \
    && make lnp \
    && make install \
    && cd .. \
    && rm -rf imap-2007f imap-2007f.tar.gz


# 3. Встановлюємо PHP IMAP, використовуючи c-client зі source
RUN docker-php-ext-configure imap --with-kerberos --with-imap=/usr/local \
    && docker-php-ext-install imap \
    && docker-php-ext-install gd mysqli mbstring pdo pdo_mysql zip xml curl

# 4. Встановлюємо Composer
RUN php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');" \
    && php composer-setup.php --install-dir=/usr/local/bin --filename=composer \
    && php -r "unlink('composer-setup.php');"

WORKDIR /var/www/activecollab.example.com
EXPOSE 9000
CMD ["php-fpm"]
